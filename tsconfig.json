{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node", "mocha", "chai"]
  },
  "include": [
    "backend/**/*.js",
    "server/**/*.js",
    "ai/**/*.js",
    "aiClients/**/*.js",
    "blockchain/**/*.js",
    "scripts/**/*.js",
    "test/**/*.js",
    "tests/**/*.js",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "next-app",
    "frontend/.next",
    "frontend/.next/**",
    "**/*.d.ts"
  ]
}
