# Copy to .env.qnap on the NAS, set mode 600, and replace every REQUIRED value.
# Keep .env.qnap on the NAS only; never commit it or paste its secrets into logs.

# QNAP inventory (REQUIRED, non-secret)
SAFESOUND_QNAP_MODEL=REQUIRED-exact-model
SAFESOUND_QNAP_OS=QTS
SAFESOUND_QNAP_OS_VERSION=REQUIRED-5.1-or-newer-build
SAFESOUND_CONTAINER_STATION_VERSION=REQUIRED-3.x-build
SAFESOUND_QNAP_PLATFORM=REQUIRED-linux-amd64-or-linux-arm64
SAFESOUND_QNAP_ACCESS_MODE=local-only

# Stable deployment identity (REQUIRED, non-secret)
COMPOSE_PROJECT_NAME=safesoundarena-qnap
SAFESOUND_QNAP_RELEASE_ID=REQUIRED-git-sha
SAFESOUND_QNAP_FEATURE_VOLUME=safesoundarena_qnap_feature_data
SAFESOUND_QNAP_IPFS_VOLUME=safesoundarena_qnap_ipfs_data
SAFESOUND_QNAP_EXPECT_EXISTING_DATA=false
SAFESOUND_QNAP_ENABLE_IPFS=false

# Runtime security (REQUIRED; generate ADMIN_TOKEN locally on the NAS)
NODE_ENV=production
AI_CONTROL_ROOM_ENV=production
ADMIN_TOKEN=REQUIRED-generate-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Safe baseline: no AI enrichment or external integrations.
GLOBAL_AI_ENABLED=false
MSHIX_BRAIN_AUTO_ENRICH=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
PI_API_KEY=
AI_ADMIN_TOKEN=
AI_AGENT_TOKEN=

# Required only after SAFESOUND_QNAP_ENABLE_IPFS=true is approved. Use a digest,
# not latest; the placeholder is intentionally rejected by the preflight.
SAFESOUND_QNAP_IPFS_IMAGE=ipfs/kubo:latest

# Bounded local container logs and a preflight disk-capacity floor.
SAFESOUND_QNAP_LOG_MAX_SIZE=10m
SAFESOUND_QNAP_LOG_MAX_FILES=3
SAFESOUND_QNAP_MIN_FREE_GB=20
