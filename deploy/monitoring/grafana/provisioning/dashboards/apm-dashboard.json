  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "name": "DS_PROMETHEUS",
        "type": "datasource"
      },
      {
        "description": "Filter by service",
        "includeAll": true,
        "multi": true,
        "name": "service",
        "query": "label_values(http_requests_total, service)",
