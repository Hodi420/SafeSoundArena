{{ define "email.default.subject" }}[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }} - {{ .CommonLabels.severity | toUpper }}{{ end }}

{{ define "email.default.html" }}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{ template "email.default.subject" . }}</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .alert { border-left: 4px solid #e74c3c; padding: 10px 15px; margin: 10px 0; background: #f9f9f9; }
        .resolved { border-left-color: #2ecc71; }
        .header { background: #f5f5f5; padding: 10px 15px; margin-bottom: 15px; border-bottom: 1px solid #ddd; }
        .label { font-weight: bold; display: inline-block; min-width: 100px; }
        .footer { margin-top: 20px; font-size: 0.9em; color: #777; }
        table { width: 100%; border-collapse: collapse; margin: 10px 0; }
        th, td { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
    <div class="header">
        <h2>{{ template "email.default.subject" . }}</h2>
    </div>

    {{ if .Alerts }}
        {{ range $i, $alert := .Alerts }}
            <div class="alert {{ if eq $alert.Status "resolved" }}resolved{{ end }}">
                <h3>{{ $alert.Labels.alertname }} ({{ $alert.Status }})</h3>
                <p>{{ $alert.Annotations.description }}</p>
                
                <h4>Details</h4>
                <table>
                    <tr>
                        <th>Label</th>
                        <th>Value</th>
                    </tr>
                    {{ range $key, $value := $alert.Labels }}
                        <tr>
                            <td><strong>{{ $key }}</strong></td>
                            <td>{{ $value }}</td>
                        </tr>
                    {{ end }}
                </table>
                
                {{ if $alert.Annotations.runbook }}
                    <h4>Runbook</h4>
                    <p>{{ $alert.Annotations.runbook }}</p>
                {{ end }}
                
                <p><small>Starts: {{ $alert.StartsAt.Format "2006-01-02 15:04:05 UTC" }}</small></p>
                {{ if eq $alert.Status "resolved" }}
                    <p><small>Resolved: {{ $alert.EndsAt.Format "2006-01-02 15:04:05 UTC" }}</small></p>
                {{ end }}
                
                {{ if $alert.GeneratorURL }}
                    <p><a href="{{ $alert.GeneratorURL }}">🔍 View in Prometheus</a></p>
                {{ end }}
            </div>
        {{ end }}
    {{ else }}
        <p>No alerts to display</p>
    {{ end }}
    
    <div class="footer">
        <p>This is an automated message. Please do not reply to this email.</p>
        {{ if .ExternalURL }}
            <p><a href="{{ .ExternalURL }}">View in Alertmanager</a></p>
        {{ end }}
    </div>
</body>
</html>
{{ end }}
