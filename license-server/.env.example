# קובץ דוגמה למשתני סביבה עבור שרת רישיונות SafeSoundArena
# העתק קובץ זה ל- .env והגדר את הערכים המתאימים

# הגדרות שרת
LICENSE_SERVER_PORT=3010
NODE_ENV=production

# מפתחות אבטחה - יש להחליף בערכים מאובטחים בסביבת הייצור!
JWT_SECRET=change_this_to_a_secure_random_string_in_production
ENCRYPTION_KEY=change_this_to_a_secure_random_string_in_production
SIGNING_KEY=change_this_to_a_secure_random_string_in_production
ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# הגדרות CORS
# רשימת מקורות מורשים מופרדים בפסיקים, או * לאפשר הכל (לא מומלץ בייצור)
ALLOWED_ORIGINS=http://localhost:3000,https://app.safesoundarena.com

# הגדרות Redis (אם משתמשים בשירות Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_secure_password_in_production

# הגדרות לוגים
LOG_LEVEL=info

# הגדרות הגבלת קצב בקשות
RATE_LIMIT_WINDOW_MS=900000  # 15 דקות
RATE_LIMIT_MAX_REQUESTS=100  # מקסימום בקשות בחלון הזמן

# הגדרות אבטחה נוספות
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true
ENABLE_BRUTE_FORCE_PROTECTION=true

# הגדרות ניטור (אופציונלי)
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090

# הגדרות התראות (אופציונלי)
ALERT_EMAIL=security@safesoundarena.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alert@safesoundarena.com
SMTP_PASSWORD=your_smtp_password