{
  "name": "@safesoundarena/client-sdk",
  "version": "1.0.0",
  "description": "Official JavaScript client SDK for SafeSoundArena game server",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "browser": "dist/safesoundarena-client.min.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safesoundarena/client-sdk-js.git"
  },
  "keywords": [
    "safesoundarena",
    "game",
    "websocket",
    "client",
    "sdk"
  ],
  "author": "SafeSoundArena Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/safesoundarena/client-sdk-js/issues"
  },
  "homepage": "https://github.com/safesoundarena/client-sdk-js#readme",
  "devDependencies": {
    "@babel/core": "^7.18.10",
    "@babel/preset-env": "^7.18.10",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-terser": "^0.1.0",
    "@types/jest": "^28.1.7",
    "@types/ws": "^8.5.3",
    "eslint": "^8.21.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^28.1.3",
    "prettier": "^2.7.1",
    "rollup": "^2.77.2",
    "rollup-plugin-terser": "^7.0.2",
    "ws": "^8.8.1"
  },
  "peerDependencies": {
    "ws": ">=8.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
