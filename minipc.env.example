# Copy to .env.minipc on the Ubuntu Mini-PC, set mode 600, and replace every
# REQUIRED value. Keep this file on the target only; never commit it or paste
# its secrets into logs, tickets, or chat.

# Target inventory (non-secret)
SAFESOUND_MINIPC_HOSTNAME=REQUIRED-hostname
SAFESOUND_MINIPC_OS=Ubuntu
SAFESOUND_MINIPC_OS_VERSION=REQUIRED-22.04-or-newer-version
SAFESOUND_MINIPC_PLATFORM=REQUIRED-linux-amd64-or-linux-arm64
SAFESOUND_MINIPC_ACCESS_MODE=ssh-tunnel
SAFESOUND_DOCKER_ENGINE_VERSION=REQUIRED-docker-server-version
SAFESOUND_DOCKER_API_VERSION=REQUIRED-docker-api-version

# Stable deployment identity (REQUIRED, non-secret)
COMPOSE_PROJECT_NAME=safesoundarena-minipc
SAFESOUND_MINIPC_RELEASE_ID=REQUIRED-git-sha
SAFESOUND_MINIPC_FEATURE_VOLUME=safesoundarena_minipc_feature_data
SAFESOUND_MINIPC_EXPECT_EXISTING_DATA=false
SAFESOUND_MINIPC_API_IMAGE_ID=
SAFESOUND_MINIPC_FRONTEND_IMAGE_ID=
SAFESOUND_MINIPC_FEATURE_VOLUME_DRIVER=local
SAFESOUND_MINIPC_FEATURE_VOLUME_MOUNTPOINT=

# Runtime security. Generate ADMIN_TOKEN with: openssl rand -hex 32
NODE_ENV=production
AI_CONTROL_ROOM_ENV=production
ADMIN_TOKEN=REQUIRED-generate-64-hex-characters
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Private baseline: no AI enrichment, provider egress, or external integrations.
GLOBAL_AI_ENABLED=false
MSHIX_BRAIN_AUTO_ENRICH=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
PI_API_KEY=
AI_ADMIN_TOKEN=
AI_AGENT_TOKEN=

# Bounded local container logs and preflight capacity floors. These are safety
# floors, not proof that the unknown hardware is sufficiently sized.
SAFESOUND_MINIPC_LOG_MAX_SIZE=20m
SAFESOUND_MINIPC_LOG_MAX_FILES=5
SAFESOUND_MINIPC_MIN_FREE_GB=30
SAFESOUND_MINIPC_MIN_TOTAL_RAM_MB=4096
SAFESOUND_MINIPC_MIN_AVAILABLE_RAM_MB=1024
