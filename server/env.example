PORT=3005

# Security (recommended in non-DEV)
#MCP_API_KEY=

# Feature flags (use with caution)
MCP_ENABLE_SHELL=false
MCP_ENABLE_GIT=false
MCP_ENABLE_HTTP=false

# CORS allowlist (comma-separated origins)
#MCP_CORS_ORIGINS=https://your.domain.com,https://admin.domain.com

# HTTP client allowlist (comma-separated hostnames)
#MCP_HTTP_ALLOWLIST=example.com,api.your.domain.com


