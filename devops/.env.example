# SafeSoundArena Environment Variables Template
# Copy this file to .env and fill in actual values

# ==================== Application ====================
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ==================== Pi Network ====================
PI_API_KEY=your_pi_api_key_here
PI_NETWORK=testnet  # testnet or mainnet

# ==================== AI/OpenAI ====================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# ==================== Security ====================
ADMIN_TOKEN=your_secure_admin_token_here
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# ==================== Database ====================
DATABASE_URL=mongodb://your_mongo_host/safesoundarena
MONGO_USER=root
MONGO_PASSWORD=your_mongo_password

# ==================== Redis Cache ====================
REDIS_PASSWORD=your_redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== ClickHouse Analytics ====================
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000

# ==================== Blockchain ====================
ETH_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
CONTRACT_ADDRESS=0xyourcontractaddress
PRIVATE_KEY=your_private_key_here

# ==================== IPFS ====================
IPFS_HOST=ipfs
IPFS_PORT=5001
IPFS_GATEWAY=http://ipfs:8080

# ==================== Monitoring & Logging ====================
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION=30d
ELK_USERNAME=elastic
ELK_PASSWORD=changeme

# ==================== Email (Optional) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@safesoundarena.com

# ==================== AWS/Cloud (Optional) ====================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
S3_BUCKET=safesoundarena

# ==================== Feature Flags ====================
ENABLE_JAILTIME=true
ENABLE_MARKETPLACE=true
ENABLE_NFT_MINTING=true
ENABLE_BLOCKCHAIN_SYNC=true
