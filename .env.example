# Example .env file for SafeSoundArena

# === AI Provider Integration ===
# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Anthropic Claude
CLAUDE_API_KEY=your-claude-key

# Google Gemini
GEMINI_API_KEY=your-gemini-key

# Hugging Face
HUGGINGFACE_API_KEY=your-huggingface-key

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key

# Telegram Bot (if used)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Ollama usually runs locally, no API key needed by default

# === הגדרות אבטחה בסיסיות ===
# מפתח סודי לחתימת JWT (יש לשנות בסביבת ייצור!)
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# מפתח להצפנת מידע רגיש (יש לשנות בסביבת ייצור!)
ENCRYPTION_KEY=change_this_to_a_secure_random_hex_string_in_production

# מפתח לחתימת נתונים (יש לשנות בסביבת ייצור!)
SIGNING_KEY=change_this_to_a_secure_random_string_in_production

# === הגדרות רישיון ===
# מפתח רישיון ראשי (יש לקבל מספק הרישיון)
MASTER_LICENSE_KEY=your_license_key_here

# מזהה מופע (ייחודי לכל התקנה)
INSTANCE_ID=your_instance_id_here

# מזהה רישיון (מקושר למפתח הרישיון)
LICENSE_ID=your_license_id_here

# כתובת שרת אימות רישיונות
LICENSE_SERVER=https://license.safesoundarena.com/verify

# === Blockchain Settings ===
# Blockchain RPC URL (Ganache, Infura, Alchemy, etc.)
BLOCKCHAIN_RPC_URL=http://localhost:8545

# Contract Address (deployed SafeSoundArena contract)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Wallet Private Key (for transactions, keep secure!)
WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# === WebSocket Settings ===
WEBSOCKET_PORT=3001

# === Database Settings ===
MONGODB_URI=mongodb://mongo:27017/safesoundarena
REDIS_URL=redis://redis:6379

# === Environment Settings ===
# Runtime environment (development, production, test)
NODE_ENV=development

# פורט לשרת ה-API
API_PORT=3000
PORT=4000

# כתובת ה-API עבור הממשק
NEXT_PUBLIC_API_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# Backend dev security
DEV_ACCESS_TOKEN=your-dev-token-here
FORCE_DEV_GATE=false

# Pi Network API Key
PI_API_KEY=your-pi-key-here

# Local AI endpoints
OLLAMA_BASE_URL=http://localhost:11434
TGI_BASE_URL=http://localhost:8081

# Admin authentication
ADMIN_TOKEN=your-admin-token-here

# === הגדרות אבטחה מתקדמות ===
# האם להפעיל בדיקות אותנטיות קוד
ENABLE_CODE_INTEGRITY_CHECK=true

# האם להפעיל סימני מים דיגיטליים
ENABLE_DIGITAL_WATERMARKS=true

# האם להפעיל הגנה מפני התקפות DDoS
ENABLE_DDOS_PROTECTION=true

# מספר בקשות מקסימלי לדקה מכל כתובת IP
RATE_LIMIT_MAX_REQUESTS=100

# חלון זמן להגבלת קצב בקשות (במילישניות)
RATE_LIMIT_WINDOW_MS=60000

# === הגדרות ניטור ===
# האם להפעיל ניטור ביצועים
ENABLE_PERFORMANCE_MONITORING=true

# האם לשלוח התראות על אירועי אבטחה
ENABLE_SECURITY_ALERTS=true

# כתובת דוא"ל לקבלת התראות אבטחה
SECURITY_ALERT_EMAIL=security@example.com
