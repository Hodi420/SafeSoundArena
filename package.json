{
  "name": "safesoundarena-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "test": "mocha --exit",
    "start": "cd backend && npm start",
    "dev": "cd frontend && npm run dev",
    "lint": "npm run lint:frontend",
    "test:frontend": "cd frontend && npm test",
    "build:frontend": "cd frontend && npm run build",
    "lint:frontend": "cd frontend && npm run lint"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "mocha": "^10.0.0",
    "sinon": "^20.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.1"
  }
}
